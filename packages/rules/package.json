{
  "name": "@rift/rules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.host.config.ts",
    "test:host": "vitest run --config vitest.host.config.ts",
    "selfplay": "vitest run --config test/bot/vitest.selfplay.config.ts",
    "scenario": "node scripts/scenario.mjs",
    "coverage:rules": "node scripts/rules-coverage.mjs",
    "coverage:cards": "node scripts/card-coverage.mjs",
    "coverage:check": "node scripts/card-coverage.mjs --check && node scripts/rules-coverage.mjs --check"
  },
  "dependencies": {
    "@rift/cards": "workspace:*",
    "@rift/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
